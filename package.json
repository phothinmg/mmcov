{
  "name": "mmcov",
  "version": "0.0.8",
  "description": "Lcov viewer",
  "keywords": [
    "lcov",
    "lcov viewer"
  ],
  "homepage": "https://github.com/phothinmg/mmcov/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/phothinmg/mmcov/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Pho Thin Mg",
    "email": "phothinmg@disroot.org",
    "url": "https://phothinmg.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phothinmg/mmcov.git"
  },
  "bin": {
    "mmcov": "bin/mmcov"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "dist/**/*",
    "public",
    "bin"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "hooks:install": "bash scripts/install-hooks.sh",
    "commit": "bash scripts/commit.sh",
    "build": "susee build",
    "v:patch": "npm version patch --no-git-tag-version",
    "v:minor": "npm version minor --no-git-tag-version",
    "v:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@shikijs/transformers": "^4.3.1",
    "html-minifier-next": "^7.2.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@oxc-node/cli": "^0.1.0",
    "@types/html-minifier-next": "^2.1.1",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "susee": "^2.3.0",
    "typescript": "^7.0.2"
  }
}
